# ---------------------------------------------------------------------------
# Pouya Khalaj — environment variables (optional)
# Copy to `.env.local` on your server. The site works without any of these:
# if SMTP is not configured, form submissions are stored in ./data/*.jsonl
# ---------------------------------------------------------------------------

# Public site URL (used for sitemap, robots, canonical + OpenGraph tags)
NEXT_PUBLIC_SITE_URL=https://pouyakhalaj.ir

# Where form notifications should be sent
LEAD_TO_EMAIL=hello@pouyakhalaj.ir

# --- Option A: SMTP (recommended) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pouya Khalaj Website <no-reply@pouyakhalaj.ir>"

# --- Option B: webhook (Slack / Make / n8n / any JSON endpoint) ------------
LEAD_WEBHOOK_URL=

# --- Option C: Telegram bot ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
